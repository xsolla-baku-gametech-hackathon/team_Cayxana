[
  {
    "id": "r_fast_reaction",
    "when": [
      {
        "feat": "reaction_delay",
        "op": "<=",
        "v": 25
      }
    ],
    "weight": 0.45,
    "rationale": "standing on the loot within ~1.2 s of it existing; a person cannot get there that fast unless they were already walking at something they could not see",
    "author": "human",
    "status": "active",
    "createdAt": "2026-09-10T00:00:00.000Z",
    "backtest": null,
    "approvedBy": "rules v1"
  },
  {
    "id": "r_instant_pickup",
    "when": [
      {
        "feat": "reaction_delay",
        "op": "<=",
        "v": 12
      },
      {
        "feat": "dwell_ticks",
        "op": "<=",
        "v": 3
      }
    ],
    "weight": 0.35,
    "rationale": "arrived within half a second and moved straight on without looking - a collection loop consuming an item, not a person noticing one",
    "author": "human",
    "status": "active",
    "createdAt": "2026-09-10T00:00:00.000Z",
    "backtest": null,
    "approvedBy": "rules v1"
  },
  {
    "id": "r_straight_line",
    "when": [
      {
        "feat": "path_straightness",
        "op": ">=",
        "v": 0.92
      }
    ],
    "weight": 0.45,
    "rationale": "SHADOW, and this is why: measured on this map it fires on 1% of bot episodes and 6% of human ones. The bot generation that walks around obstacles no longer walks straight lines, so the classic straight-line tell now describes a person crossing a corridor better than it describes a bot. Kept visible rather than deleted - it is the clearest evidence we have that a hand-written rule needs a backtest as much as an agent-written one does.",
    "author": "human",
    "status": "shadow",
    "createdAt": "2026-09-10T00:00:00.000Z",
    "backtest": null,
    "approvedBy": null
  },
